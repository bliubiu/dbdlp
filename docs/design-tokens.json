      "tanstackReactTable": "8.21.3（v9 为破坏性 API 变更，不追新）"
    },
    "iconLibrary": {
      "name": "lucide-react",
      "version": "1.72.0",
      "lockedBy": "项目总监最终裁定（覆盖此前所有中转）；npm view 实时版本 + 包内类型声明导出名核验为据；写入 package.json 并锁 lock 文件，禁止浮动版本",
      "verifiedBy": "npm view 实时版本 + npm pack 1.72.0 包内类型声明导出名核验：dist/lucide-react.d.ts 共 4106 个唯一导出名，逐一比对候选 125 个图标名，缺失 0 个；04 文档 §6.3/§6.4 实际引用 109 个，全部命中",
      "versionPolicy": "写入 package.json 并锁 lock 文件，禁止跨版本浮动；仅具名导入，禁止 import * as icons；禁止第二套图标库、图标字体、自绘 SVG、emoji 功能图标",
      "sizes": { "inline": 16, "inButton": 20, "standalone": 24 },
      "strokeWidth": 2,
      "color": "currentColor，颜色继承 CSS 变量，禁止硬编码色值（例外仅 #fff / #000）"
    },
    "interfaceContract": "统一响应 { code, data, message }；分页 data { items, total, page, limit, hasMore }；端点直接引用架构文档 v2.0 §13.2，不另造接口命名；除 POST /api/v1/auth/login 外全部需 Bearer 会话认证；单管理员 + 会话，不做 SSO/LDAP",
    "maskingPolicy": "密码、IP、身份证、手机号、邮箱等敏感信息脱敏；IPv4 前两段以 * 替换并保留后两段（192.168.10.3 → *.*.10.3）；127.0.0.1 与 localhost 保留完整；其他敏感数据用 * 号替换；SQL 输出字面量结果、运行日志、报告文件三处强制脱敏；响应中 password 恒为 ******；前端只消费 sampleMasked，不展示/存储/拼接完整明文",
    "reportPolicy": "输出 Excel / HTML / JSON；内容可包含实例、模式、表、字段、样本（仅掩码）、命中数、风险等级；流式处理大结果集时前端服务端分页展示 + 后端流式导出，不一次性全量载入浏览器；所有错误信息与 UI 文案使用中文，不暴露堆栈、连接串、密钥路径与完整凭据",
    "errorMessageLanguage": "zh-CN（总纲要求所有错误信息必须使用中文）"
  },

